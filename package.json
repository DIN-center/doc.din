{
  "name": "doc.din",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "gen-api": "docusaurus gen-api-docs all",
    "clean-api": "docusaurus clean-api-docs all",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "typecheck-staged": "tsc-files --noEmit",
    "lint": "npm run lint:js && npm run lint:style",
    "lint:js": "eslint . --ext js,jsx,ts,tsx --max-warnings=0",
    "lint:style": "stylelint \"**/*.css\"",
    "lint:fix": "npm run lint:js -- --fix",
    "format": "prettier --write '{blog,docs,src,static}/**/*.{md,mdx,ts,js,tsx,jsx,json}'",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,js,jsx,tsx}": [
      "eslint --ext js,jsx,ts,tsx --max-warnings=0 --fix",
      "prettier --write"
    ],
    "**/*.{ts,tsx}": "tsc-files --noEmit",
    "**/*.css": "stylelint",
    "**/*.{md,mdx}": "prettier --write",
    "**/*.json": "prettier --write"
  },
  "dependencies": {
    "@docusaurus/core": "^3.9.2",
    "@docusaurus/faster": "^3.9.2",
    "@docusaurus/plugin-client-redirects": "^3.9.2",
    "@docusaurus/plugin-content-docs": "^3.9.2",
    "@docusaurus/plugin-content-pages": "^3.9.2",
    "@docusaurus/plugin-google-gtag": "^3.9.2",
    "@docusaurus/plugin-google-tag-manager": "^3.9.2",
    "@docusaurus/preset-classic": "^3.9.2",
    "@docusaurus/theme-classic": "^3.9.2",
    "@docusaurus/theme-mermaid": "^3.9.2",
    "@easyops-cn/docusaurus-search-local": "^0.44.0",
    "@mdx-js/react": "^3.0.0",
    "@mermaid-js/layout-elk": "^0.1.9",
    "clsx": "^1.2.1",
    "docusaurus-plugin-llms": "^0.2.2",
    "prism-react-renderer": "^2.1.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.2.0",
    "@commitlint/config-conventional": "^18.1.0",
    "@docusaurus/eslint-plugin": "^3.9.2",
    "@docusaurus/module-type-aliases": "^3.9.2",
    "@docusaurus/tsconfig": "^3.9.2",
    "@docusaurus/types": "^3.9.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^10.0.4",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^8.0.7",
    "@semantic-release/npm": "^10.0.2",
    "@semantic-release/release-notes-generator": "^10.0.3",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint-plugin-react": "^7.33.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "semantic-release": "^24.2.9",
    "stylelint": "^15.0.0 ",
    "stylelint-config-standard": "^34.0.0",
    "tsc-files": "^1.1.4",
    "typescript": "~5.3.3"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "overrides": {
    "node-forge": "^1.3.2",
    "lodash": "^4.17.23",
    "lodash-es": "^4.17.23",
    "mdast-util-to-hast": "^13.2.1",
    "@docusaurus/utils": {
      "js-yaml": "^4.1.1"
    },
    "@docusaurus/utils-validation": {
      "js-yaml": "^4.1.1"
    },
    "@docusaurus/plugin-content-docs": {
      "js-yaml": "^4.1.1"
    },
    "eslint": {
      "js-yaml": "^4.1.1"
    },
    "gray-matter": {
      "js-yaml": "^3.14.2"
    },
    "qs": "^6.14.1"
  }
}
